# Production environment template.
#
#   cp .env.prod.example .env.prod   # then replace every CHANGE_ME
#
# Used by docker-compose.prod.yml via both `--env-file .env.prod` (interpolation)
# and the api service `env_file`. Never commit the real .env.prod.

SERVER_PORT=8080
SERVER_SHUTDOWN_TIMEOUT=10s
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s
# Maximum accepted request body size in bytes (default 2 MiB). Requests above
# the limit are rejected with 413 before the body is processed.
SERVER_MAX_BODY_BYTES=2097152
# Reverse proxies whose forwarding headers (X-Forwarded-For/X-Real-IP) may be
# trusted when resolving the client IP: a comma-separated list of IPs/CIDRs.
# Set this to your load balancer / reverse proxy addresses when the API runs
# behind one; leave it empty when the API is exposed directly.
TRUSTED_PROXIES=

ENVIRONMENT=production

# With managed services, point these at the real endpoints (and see the
# commented block in docker-compose.prod.yml).
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_NAME=hexago
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=require
DB_TIMEZONE=UTC
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
# Run versioned migrations as a separate step instead of on every boot.
DB_AUTO_MIGRATION=false

# Seeding is a bootstrap-only action; keep it off once the admin exists.
SEED_ENABLED=false
ADMIN_USERNAME=admin.local
ADMIN_EMAIL=admin@hexago.local
ADMIN_PASSWORD=CHANGE_ME

# bcrypt cost: an integer between 4 and 31 (values below 10 are logged as a
# warning). Raise it on faster hardware; it bounds how long hashing takes.
HASHER_COST=12

# Replace `JWT_SECRET` with a cryptographically secure, randomly generated
# secret containing at least 32 characters.
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION=1h

# Rate limiting (token bucket backed by Redis).
# REDIS_ADDR points to the bundled service unless overridden to a managed one.
REDIS_ADDR=redis:6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
REDIS_POOL_SIZE=10

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AUTH_REFILL_RATE=0.2
RATE_LIMIT_USER_CAPACITY=60
RATE_LIMIT_USER_REFILL_RATE=1
