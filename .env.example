SERVER_PORT=8080
SERVER_SHUTDOWN_TIMEOUT=5s
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s
# Maximum accepted request body size in bytes (default 2 MiB). Requests above
# the limit are rejected with 413 before the body is processed.
SERVER_MAX_BODY_BYTES=2097152
# Reverse proxies whose forwarding headers (X-Forwarded-For/X-Real-IP) may be
# trusted when resolving the client IP: a comma-separated list of IPs/CIDRs.
# Leave empty when the API is exposed directly so the socket address is used and
# X-Forwarded-For is ignored (otherwise clients could spoof their IP).
TRUSTED_PROXIES=

ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=hexago
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=disable
DB_TIMEZONE=UTC
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
# Required on a fresh database: creates the user/roles/permissions tables.
# Keep it false in production and run versioned migrations instead.
DB_AUTO_MIGRATION=true

# Required on a fresh database: creates the admin user and its RBAC permissions.
# Without it (or if the admin user predates the RBAC tables), authenticated
# requests to guarded routes return 403 because user_roles/role_permissions
# are empty.
SEED_ENABLED=true
ADMIN_USERNAME=admin.local
ADMIN_EMAIL=admin@hexago.local
ADMIN_PASSWORD=CHANGE_ME

# bcrypt cost: an integer between 4 and 31 (values below 10 are logged as a
# warning). Raise it on faster hardware; it bounds how long hashing takes.
HASHER_COST=12

# Replace `JWT_SECRET` with a cryptographically secure, randomly generated
# secret containing at least 32 characters.
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION=24h

# Rate limiting (token bucket backed by Redis).
# Running via `docker compose`, the api service overrides DB_HOST=postgres and
# REDIS_ADDR=redis:6379; the values below are for running the app on the host.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
REDIS_POOL_SIZE=10

RATE_LIMIT_ENABLED=true
# Login: strict, keyed by client IP.
RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AUTH_REFILL_RATE=0.2
# Authenticated routes: keyed by user ID.
RATE_LIMIT_USER_CAPACITY=60
RATE_LIMIT_USER_REFILL_RATE=1